NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://fcea_app:CHANGE_ME@127.0.0.1:5432/fceadatasys
# Generar al menos 32 caracteres aleatorios. Nunca reutilizar entre entornos.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=fceadatasys
JWT_AUDIENCE=fceadatasys-client
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_COOKIES=false
RECOVERY_URL=http://localhost:5173/#reset
# Rutas relativas al cwd de server. Almacenamiento privado, fuera de client/public.
ATTACHMENT_DIRECTORY=.local/attachments
# Windows x64; en Linux usar clamscan o su ruta absoluta.
CLAMAV_COMMAND=C:\Program Files\ClamAV\clamscan.exe
CLAMAV_DATABASE_DIR=.local/clamav/database
CLAMAV_TIMEOUT_MS=120000
CLAMAV_MAX_SIGNATURE_AGE_DAYS=7
ATTACHMENT_CONCURRENCY=2
# Opcional: sin SMTP la recuperación responde genéricamente y no entrega correos.
# Gmail: contraseña de aplicación, no contraseña de acceso a la cuenta.
# POP/IMAP no se usan. El secreto se guarda solo en .env, nunca en Git.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=true
# Para otro proveedor con STARTTLS: SMTP_PORT=587 y SMTP_SECURE=false.

# Proxy local del lanzador; dejar vacío si la API se usa directamente.
TRUSTED_PROXIES=
