NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://fcea_production_app:CHANGE_ME@127.0.0.1:5432/fceadatasys_production
INITIAL_DATA_PROFILE=production
INITIAL_DATA_DATABASE_NAME=fceadatasys_production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=fceadatasys
JWT_AUDIENCE=fceadatasys-client
ALLOWED_ORIGINS=https://catalogo.example.invalid
SECURE_COOKIES=true
RECOVERY_URL=https://catalogo.example.invalid/#reset
ATTACHMENT_DIRECTORY=.local/production/attachments
CLAMAV_COMMAND=C:\Program Files\ClamAV\clamscan.exe
CLAMAV_DATABASE_DIR=.local/clamav/database
CLAMAV_TIMEOUT_MS=120000
CLAMAV_MAX_SIGNATURE_AGE_DAYS=7
ATTACHMENT_CONCURRENCY=2
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_CI=0000000
BOOTSTRAP_ADMIN_USERNAME=admin
# Completar localmente: sin valores predeterminados ni credenciales de demostración.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Configurar SMTP institucional para habilitar entrega de recuperación; ver docs/EMAIL.md.

# Proxy local del lanzador; dejar vacío si la API se usa directamente.
TRUSTED_PROXIES=
