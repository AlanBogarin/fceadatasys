{
  "name": "fceadatasys-server",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "type": "module",
  "engines": { "node": ">=24.11.0 <25" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:unit:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-exclude=src/main.ts test/unit/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.test --import tsx --test test/security.test.ts test/users.integration.test.ts test/profile.integration.test.ts test/catalogs.integration.test.ts test/publications.integration.test.ts test/publication-queries.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "db:dev": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "db:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.44.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^6.0.0",
    "nodemailer": "10.0.16",
    "pg": "^8.16.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.5",
    "prisma": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
}
