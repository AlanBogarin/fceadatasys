NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://fcea_demo_app:CHANGE_ME@127.0.0.1:5432/fceadatasys_demo
INITIAL_DATA_PROFILE=demo
INITIAL_DATA_DATABASE_NAME=fceadatasys_demo
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=fceadatasys-demo
JWT_AUDIENCE=fceadatasys-demo-client
ALLOWED_ORIGINS=http://127.0.0.1:5173
SECURE_COOKIES=false
RECOVERY_URL=http://127.0.0.1:5173/#reset
ATTACHMENT_DIRECTORY=.local/demo/attachments
CLAMAV_COMMAND=C:\Program Files\ClamAV\clamscan.exe
CLAMAV_DATABASE_DIR=.local/clamav/database
CLAMAV_TIMEOUT_MS=120000
CLAMAV_MAX_SIGNATURE_AGE_DAYS=7
ATTACHMENT_CONCURRENCY=2
# Exclusivas de demostración. Nunca usar estas contraseñas en producción.
DEMO_ADMIN_PASSWORD=Fcea2026!
DEMO_DIGITADOR_PASSWORD=Fcea2026!
DEMO_PUBLICO_PASSWORD=Fcea2026!

# Proxy local del lanzador; dejar vacío si la API se usa directamente.
TRUSTED_PROXIES=
