{
  "name": "fceadatasys-launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "start": "node scripts/run.mjs",
    "start:demo": "node scripts/run.mjs --profile demo",
    "start:production": "node scripts/run.mjs --profile production",
    "stop:demo": "node scripts/run.mjs --profile demo --stop",
    "stop:production": "node scripts/run.mjs --profile production --stop",
    "configure": "node scripts/run.mjs --configure",
    "test:deployment": "node --test scripts/deployment/*.test.mjs",
    "test:deployment:integration": "node --test scripts/deployment/launch.integration.mjs"
  }
}
