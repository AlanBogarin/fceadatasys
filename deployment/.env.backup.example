# Guardar como .local/backups/production.env (NO versionar credenciales).
# Rutas absolutas recomendadas. Las relativas parten de la carpeta de este archivo.
BACKUP_DATABASE_URL=postgresql://fcea_production_backup:CAMBIAR@127.0.0.1:5432/fceadatasys
BACKUP_DIRECTORY=/var/lib/fceadatasys/backups
PG_DUMP_COMMAND=pg_dump
PG_RESTORE_COMMAND=pg_restore
RCLONE_COMMAND=rclone
RCLONE_CONFIG=/var/lib/fceadatasys/private/rclone.conf
RCLONE_REMOTE=drive:fceadatasys/production
BACKUP_TIMEOUT_MS=1800000
