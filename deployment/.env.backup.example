# Guardar como .local/backups/production.env (NO versionar credenciales).
# Rutas absolutas recomendadas. Las relativas parten de la carpeta de este archivo.
# Obtener JSON y autorización: docs/operacion/GOOGLE-DRIVE.md. Operación: docs/operacion/BACKUPS.md.
BACKUP_DATABASE_URL=postgresql://fcea_production_backup:CAMBIAR@127.0.0.1:5432/fceadatasys
BACKUP_DIRECTORY=/var/lib/fceadatasys/backups
PG_DUMP_COMMAND=pg_dump
PG_RESTORE_COMMAND=pg_restore
# JSON descargado de un cliente OAuth de tipo aplicación de escritorio.
DRIVE_CLIENT_FILE=/var/lib/fceadatasys/private/production-drive-client.json
# Archivo distinto, generado por backup:authorize; no se rellena a mano.
DRIVE_TOKEN_FILE=/var/lib/fceadatasys/private/production-drive-token.json
# La autorización crea esta carpeta y completa su ID.
DRIVE_FOLDER_NAME=fceadatasys-production
DRIVE_FOLDER_ID=
# El perfil local production no cambia el estado Prueba/En producción de Google.
# En OAuth externo Prueba/Testing, el refresh token de Drive caduca a los 7 días.
BACKUP_TIMEOUT_MS=1800000
